            },
            {
              "column": "reason",
              "type": "text",
              "defval": ""
            },
            {
              "column": "evidence",
              "type": "text",
              "defval": ""
            },
            {
              "column": "amount_at_risk",
              "type": "text",
              "defval": ""
            },
            {
              "column": "confidence",
              "type": "text",
              "defval": "low"
            }
          ]
        }
      },
      "input": [
        {
          "lane": "questions",
          "from": "prompt_1"
        }
      ],
      "ui": {
        "position": {
          "x": 680,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "prompt_validation_1",
      "provider": "prompt",
      "config": {
        "instructions": [
          "You are a validation layer for lease audit findings. Review the extracted finding and enforce safety rules.",
          "",
          "VALIDATION RULES:",
          "1. Check ALL 6 required fields are present and non-empty: bill_name, status, reason, evidence, amount_at_risk, confidence",
          "2. Verify status is one of: \"safe\", \"needs_review\", \"likely_overcharge\"",
          "3. If any field is missing, empty, or invalid → override status to \"needs_review\" and set reason to explain what's missing",
          "4. If confidence is \"low\" or < 50 → status must be \"needs_review\"",
          "5. If amount_at_risk cannot be parsed as a dollar amount → status \"needs_review\"",
          "6. If evidence doesn't reference specific lease clauses and bill lines → status \"needs_review\"",
          "7. NEVER upgrade a finding from needs_review to likely_overcharge or safe",
          "8. Output the SAME 6 fields, corrected if needed",
          "",
          "Return the validated finding with all 6 fields."
        ],
        "parameters": {}
      },
      "input": [
        {
          "lane": "answers",
          "from": "extract_data_1"
        },
        {
          "lane": "questions",
          "from": "extract_data_1"
        }
      ],
      "ui": {
        "position": {
          "x": 900,
          "y": 200
        },
        "measured": {
          "width": 150,
          "height": 66
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "llm_anthropic_2",
